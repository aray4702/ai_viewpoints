# Copy to .env and fill in.

# Claude: triage (Haiku 4.5) + viewpoint extraction (Sonnet 5.5)
ANTHROPIC_API_KEY=
# Gemini: transcribes YouTube videos without captions, and podcast audio
GEMINI_API_KEY=
# Voyage: claim embeddings for dedup + semantic search (optional; skipped without it)
VOYAGE_API_KEY=

# Web / auth
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_EMAILS=[]
WEB_BASE_URL=http://localhost:3000
RESEND_API_KEY=
EMAIL_FROM=Their Take <noreply@example.com>
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Optional overrides
# DATA_DIR=./data
# TRIAGE_MODEL=claude-haiku-4-5
# EXTRACT_MODEL=claude-sonnet-5-5
# EXTRACT_EFFORT=medium
# GEMINI_MODEL=gemini-2.5-flash
